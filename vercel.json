{
  "version": 2,
  "builds": [
    {
      "src": "api/iyzico/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/iyzico/initialize",
      "dest": "/api/iyzico/initialize.js"
    },
    {
      "src": "/api/iyzico/callback",
      "dest": "/api/iyzico/callback.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

# Server & App Settings
PORT=3000
APP_BASE_URL=https://lambospec.ai
APP_SUCCESS_URL=https://lambospec.ai/?payment_success=true
APP_FAIL_URL=https://lambospec.ai/?payment_failed=true

# Pricing
PRICE_USD=79.00
PRICE_TRY=2750.00

# PayTR Virtual POS Configuration (Get from PayTR Panel -> Ayarlar -> Entegrasyon Bilgileri)
PAYTR_MERCHANT_ID=your_merchant_id
PAYTR_MERCHANT_KEY=your_merchant_key
PAYTR_MERCHANT_SALT=your_merchant_salt
PAYTR_TEST_MODE=1

# Dodo Payments (Merchant of Record - Apple Pay, Google Pay, Global Cards)
DODO_PAYMENTS_LIVE_KEY=dodo_live_your_key
DODO_LIVE_PRODUCT_ID=pdt_your_product_id
DODO_PAYMENTS_TEST_KEY=dodo_test_your_key
DODO_TEST_PRODUCT_ID=pdt_your_product_id
DODO_BUSINESS_ID=bus_your_business_id

# Paddle Configuration
PADDLE_CLIENT_TOKEN=your_paddle_token
PADDLE_PRICE_ID=pri_your_price_id

# Webhooks (Dodo Payments & Whop)
DODO_WEBHOOK_SECRET=whsec_your_dodo_webhook_secret
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret
WHOP_API_KEY=your_whop_api_key

# Email Delivery (Customer + karakoc.i@gmail.com)
OWNER_EMAIL=karakoc.i@gmail.com
# Option 1: Gmail SMTP (Recommended - 16-char Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=karakoc.i@gmail.com
GMAIL_APP_PASSWORD=your_16_char_gmail_app_password
# Option 2: Resend API (with verified sending domain)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=LamboSpec AI <noreply@yourdomain.com>

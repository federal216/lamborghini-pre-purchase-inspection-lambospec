{
  "version": 2,
  "builds": [
    {
      "src": "api/paytr/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/dodo/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/paytr/initialize",
      "dest": "/api/paytr/initialize.js"
    },
    {
      "src": "/api/paytr/callback",
      "dest": "/api/paytr/callback.js"
    },
    {
      "src": "/api/dodo/initialize",
      "dest": "/api/dodo/initialize.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}

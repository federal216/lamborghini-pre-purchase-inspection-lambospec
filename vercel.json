{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "sample_report.pdf",
          "lib/**"
        ]
      }
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/status",
      "dest": "/api/status.js"
    },
    {
      "src": "/api/paytr/initialize",
      "dest": "/api/paytr/initialize.js"
    },
    {
      "src": "/api/paytr/callback",
      "dest": "/api/paytr/callback.js"
    },
    {
      "src": "/api/dodo/initialize",
      "dest": "/api/dodo/initialize.js"
    },
    {
      "src": "/api/deliver-pdf",
      "dest": "/api/deliver-pdf.js"
    },
    {
      "src": "/api/webhooks/dodo",
      "dest": "/api/webhooks/dodo.js"
    },
    {
      "src": "/api/webhooks/whop",
      "dest": "/api/webhooks/whop.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
